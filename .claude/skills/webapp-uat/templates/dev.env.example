# webapp-uat -- project values for scripts/dev.sh
#
# This file is yours: written by `/webapp-uat setup` (from what it finds in the
# repo, after you confirm), committed with your project, and never overwritten by
# the skill. scripts/dev.sh reads it every time it runs. Plain shell assignments;
# quote any value that contains spaces.

# Required. Brings up everything the app needs (backend, db, ...). Runs from the
# repo root in the background; its output goes to dev.log.
START_COMMAND='npm run dev'

# Optional. Extra teardown to run after the start process (and its children) have
# been sent SIGINT -- e.g. containers the start command doesn't stop by itself.
# Leave empty, or remove the line, for none.
STOP_COMMAND='docker compose down'

# Required unless READY_COMMAND is set. wait-ready polls http://localhost:$PORT
# once per second until it answers.
PORT='3000'

# Optional. How many seconds wait-ready keeps polling. Default 30. A per-run
# environment variable of the same name (WAIT_TIMEOUT=90 scripts/dev.sh wait-ready)
# still takes precedence over this value.
# WAIT_TIMEOUT='60'

# Optional. Replaces the port poll: wait-ready succeeds as soon as this command
# exits 0. Use it when "the port answers" isn't the same as "the app is ready".
# READY_COMMAND='curl -sf http://localhost:3000/api/health'
