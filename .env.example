# Copy to .env and fill in — .env itself is gitignored.

DATABASE_URL="postgresql://demo:demo@localhost:5433/demo_app"
SESSION_SECRET="change-me-to-a-real-random-string-before-any-real-use"

# Demo bug toggles — all unset/off by default. Set to "1" to enable one at a time.
# See README.md for what each one does and why it exists.
DEMO_BUG_PERMISSION_BYPASS=
DEMO_BUG_SILENT_COMMENT_FAILURE=
NEXT_PUBLIC_DEMO_BUG_A11Y_MISSING_LABELS=
